{
  "expo": {
    "name": "OpTogether",
    "slug": "optogether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "optogether",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F9FB",
    "description": "Finanzas del hogar para Eudys y Mei: presupuesto, pagos, deudas, ahorros y finanzas personales privadas.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eudysgarcia.optogether",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eudysgarcia.optogether",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F2C66",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpTogether necesita acceder a tus fotos para adjuntar comprobantes a los movimientos.",
          "cameraPermission": "OpTogether usa la cámara para fotografiar facturas, recibos y vouchers."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
