# ---------- Copia como .env en el servidor. NUNCA lo subas al repositorio. ----------
# URL pública final (la que pondrás en tu Caddy). Se usa para las URLs firmadas de comprobantes.
PUBLIC_URL=https://finanzas.tu-dominio.com

# Puertos locales (solo 127.0.0.1) para tu Caddy existente. Cámbialos si ya están en uso.
REST_PORT=8730
API_PORT=8731

# Solo si usas el Caddy incluido (--profile caddy) en un servidor sin proxy:
DOMAIN=finanzas.tu-dominio.com

# Genera los 4 secretos automáticamente (solo hex: base64 rompe las URLs de conexión):
#   for v in POSTGRES_PASSWORD AUTHENTICATOR_PASSWORD API_DB_PASSWORD JWT_SECRET; do sed -i "s|^$v=.*|$v=$(openssl rand -hex 32)|" .env; done
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
API_DB_PASSWORD=
JWT_SECRET=

# Solo estos correos podrán crear cuenta (separados por coma). Vacío = cualquiera.
SIGNUP_ALLOWLIST=eudys@ejemplo.com,mei@ejemplo.com

# Correo para recuperar contraseña (opcional; sin SMTP usa: docker compose exec api node src/cli.mjs reset-password <correo>)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpTogether <no-reply@tu-dominio.com>"

# Opcional: token de acceso de Expo si activas "Enhanced Security" para push
EXPO_ACCESS_TOKEN=
