# ---------------------------------------------------------------------------
# OpTogether · bloque para tu Caddyfile EXISTENTE
# Cambia el dominio. Caddy obtiene el certificado HTTPS automáticamente.
#
# A) Caddy instalado en el servidor (systemd/apt): usa tal cual (127.0.0.1).
# B) Caddy dentro de Docker (p. ej. proxy-caddy-1): usa docker-compose.proxy.yml y cambia
#    127.0.0.1:8730 → optogether-rest:3000, 127.0.0.1:8731 → optogether-api:8080
#    y 127.0.0.1:8732 → optogether-web:80
# ---------------------------------------------------------------------------
finanzas.tu-dominio.com {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 20MB
	}
	handle_path /rest/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:8731
	}
	handle /files/* {
		reverse_proxy 127.0.0.1:8731
	}
	handle /health {
		reverse_proxy 127.0.0.1:8731
	}
	handle {
		reverse_proxy 127.0.0.1:8732
	}
}
